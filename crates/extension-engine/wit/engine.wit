package rintawa:engine@0.0.1;

/// Host operations available throughout a WASM component lifecycle.
interface host {
    /// Severity level for logging messages.
    enum log-level {
        trace,
        debug,
        info,
        warn,
        error,
    }

    /// Logs a message to the host's tracing system.
    log: func(level: log-level, message: string);

    /// An explicit event-publication failure.
    variant publish-error {
        /// Event publication is unavailable until the Event Runtime exists.
        unavailable,
    }

    /// Requests host event publication.
    ///
    /// MVP 0.0.1 has no Event Runtime, so the host returns `unavailable`
    /// instead of accepting and silently discarding the event.
    publish-event: func(topic: string, payload: list<u8>) -> result<_, publish-error>;

}

/// Static contribution declarations available only from guest `register`.
interface registration {
    /// Contract provider composition supported by the current resolver.
    enum resolution-policy {
        single,
        multiple,
    }

    /// Host interaction protocol exposed by a contract.
    enum contract-protocol {
        binding,
        service,
    }

    /// An explicit failure while declaring static metadata.
    variant error {
        registration-not-active,
        duplicate-contract,
        invalid-secret-pattern,
    }

    /// Declares one versioned contract and its resolution policy.
    define-contract: func(
        name: string,
        version: u32,
        resolution: resolution-policy,
        protocol: contract-protocol,
    ) -> result<_, error>;

    /// Declares this component as a provider of one versioned contract.
    provide-contract: func(
        name: string,
        version: u32,
        required-secret-read: list<string>,
    ) -> result<_, error>;

    /// Declares this component as a consumer of one versioned contract.
    consume-contract: func(
        name: string,
        version: u32,
        required: bool,
        required-secret-read: list<string>,
    ) -> result<_, error>;

    /// Declares a static capability contract during guest `register`.
    ///
    /// Runtime service availability is separate from its public contract.
    register-capability: func(name: string, schema: string) -> result<_, error>;

    /// Removes a capability declaration staged by the current `register` call.
    unregister-capability: func(name: string) -> result<_, error>;
}

/// Reversible effects available from guest `start` and `on-event`.
interface runtime-effects {
    /// A guest-local handle for one host-owned runtime effect.
    type handle = string;

    /// An explicit failure while managing a runtime effect.
    variant error {
        runtime-not-active,
        invalid-topic,
        unknown-effect,
    }

    /// Adds an owner-scoped subscription while the guest is running.
    ///
    /// The handle is later supplied to `unsubscribe-event`. It is valid only
    /// for the current activation: the host revokes all remaining subscriptions
    /// on stop or crash, and a later start requires a new subscription.
    subscribe-event: func(topic: string) -> result<handle, error>;

    /// Removes a subscription previously returned by `subscribe-event`.
    unsubscribe-event: func(handle: handle) -> result<_, error>;
}

/// Read-only secrets capability available only while guest code is executing.
interface secrets {
    /// A secret-read failure that does not disclose values or host internals.
    variant error {
        access-not-active,
        invalid-path,
        access-denied,
        not-found,
        unavailable,
    }

    /// Reads one host-granted secret path.
    ///
    /// The host derives extension and component identity from the instance; the
    /// guest cannot supply another owner. This interface intentionally has no
    /// list, store, or delete operation.
    read: func(path: string) -> result<string, error>;
}


/// Generic unary service transport available while guest code is executing.
interface services {
    /// Transport-level routing failure.
    variant error {
        unavailable,
        not-consumer,
        not-service-contract,
        unsupported-resolution,
        cyclic-call,
        provider-busy,
        provider-failed,
        request-too-large,
        response-too-large,
    }

    /// Calls the provider selected for a versioned contract.
    call: func(
        contract: string,
        version: u32,
        payload: list<u8>,
    ) -> result<list<u8>, error>;
}

/// Guest lifecycle and event handlers implemented by the WASM plugin.
interface guest {
    /// Initial plugin registration callback.
    register: func();

    /// Called when the plugin is activated by the engine.
    start: func();

    /// Deactivates the plugin while preserving its guest instance for a later restart.
    ///
    /// The host revokes runtime effects after this callback. Full guest-state
    /// disposal happens when the component is unloaded, not on `stop` alone.
    stop: func();

    /// Dispatches a subscribed event payload to the plugin.
    on-event: func(topic: string, payload: list<u8>);

    /// Handles one unary request for a contract provided by this component.
    ///
    /// Domain-level errors are encoded by the versioned contract itself. A
    /// trap or host execution failure is reported to the caller as provider-failed.
    handle-service: func(
        contract: string,
        version: u32,
        payload: list<u8>,
    ) -> list<u8>;
}

/// The plugin world contract combining host imports and guest exports.
world plugin {
    import host;
    import registration;
    import runtime-effects;
    import secrets;
    import services;
    export guest;
}
